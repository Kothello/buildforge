# BuildForge environment

# Postgres connection — Neon free tier works great: https://neon.tech
DATABASE_URL="postgresql://user:password@host/db?sslmode=require"

# JWT secrets — any two long random strings
JWT_SECRET="change-me-to-a-long-random-string"
JWT_REFRESH_SECRET="change-me-to-a-different-long-random-string"

# Optional
PORT="3000"
NODE_ENV="development"
ENABLE_DB_SEED="true"

# Optional — only needed if you want AI-generated first-message for new leads
# OPENAI_API_KEY=""
